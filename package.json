{
  "name": "misterybox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Verdania - RPG 2D originale per browser, ispirato ai JRPG portatili dei primi anni 2000",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test.mjs && node tools/test-systems.mjs",
    "shots": "node tools/shots.mjs",
    "build:page": "npm run build && node tools/build-artifact.mjs",
    "check:deploy": "node tools/check-deploy.mjs",
    "build:drop": "node tools/build-drop.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
