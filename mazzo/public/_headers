# Intestazioni valide sia per il deploy da repository sia per il trascinamento
# su Netlify Drop: stanno dentro la cartella pubblicata, quindi seguono il
# pacchetto ovunque vada.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/mazzo.html
  Cache-Control: public, max-age=0, must-revalidate

# Il gioco non contatta nessun server: la policy lo mette nero su bianco.
# Gli script del gioco sono file propri, quelli brevi sono incorporati nella
# pagina: servono 'self' e 'unsafe-inline', niente altro.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors *
